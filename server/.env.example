# API binds locally by default. Use 0.0.0.0 only for a trusted LAN.
HOST=127.0.0.1
PORT=3333
DATABASE_PATH=./data/template-mobile.sqlite
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Chat CRUD works without these values; /v1/chat then returns 503.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TITLE_MODEL=
