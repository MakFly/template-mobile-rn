    "@tanstack/react-query": "^5.102.8",
    "assistant-stream": "^0.3.40",
    "expo": "~57.0.18",
    "expo-blur": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.16",
    "expo-haptics": "~57.0.2",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.17",
    "expo-splash-screen": "~57.0.8",
