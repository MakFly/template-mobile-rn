{
  "name": "template-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typegen": "expo customize tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api": "PORT=3333 bun run --cwd server dev",
    "api:test": "bun run --cwd server test",
    "api:typecheck": "bun run --cwd server typecheck"
  },
  "dependencies": {
