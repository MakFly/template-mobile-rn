# Base URL of the backend API.
# Leave empty to use the local mocks (no network calls).
EXPO_PUBLIC_API_URL=

# Assistant UI chat endpoint (Vercel AI SDK UI message stream protocol).
# Use an absolute URL for native iOS/Android builds.
EXPO_PUBLIC_CHAT_ENDPOINT_URL=

# Base URL of the local Hono assistant API (threads + history + chat).
# Android Emulator usually uses http://10.0.2.2:3333; iOS/web use localhost.
EXPO_PUBLIC_ASSISTANT_API_URL=
